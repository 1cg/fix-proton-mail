{
  "manifest_version": 3,
  "name": "fix-proton-mail",
  "version": "8.3",
  "description": "Keyboard triage for Proton Mail: cursor, range select, archive, reply, folders.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["https://mail.proton.me/*"],
      "js": ["fix-proton-mail.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://mail.proton.me/*"],
      "js": ["settings.js"],
      "run_at": "document_start"
    }
  ]
}
